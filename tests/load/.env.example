# command to run:
# (
#   set -a
#   source ./tests/load/.env && k6 run tests/load/route.js
# )

K6_BASE_URL='http://127.0.0.1:3000'
K6_VUS='10'
K6_DURATION='300s'

# configure PATH and METHOD to decide which sample payload to use from the below list for the test
K6_PATH='/v1/auth/login'
K6_METHOD='POST'
K6_EXPECTED_STATUS='200'

# Sample payloads for different routes
K6_METHOD_POST_PATH__v1_auth_login_PAYLOAD='{"email":"load-test@example.com","password":"test-password"}'
K6_METHOD_POST_PATH__v1_auth_signin_PAYLOAD='{"email":"load-test@example.com","password":"test-password","name":"Load Test"}'
K6_METHOD_POST_PATH__v1_auth_verify_PAYLOAD='{}'
K6_METHOD_POST_PATH__v1_auth_refresh_PAYLOAD='{}'
K6_METHOD_POST_PATH__v1_auth_logout_PAYLOAD=''
K6_METHOD_POST_PATH__v1_auth_forgot_password_PAYLOAD='{"email":"load-test@example.com"}'
K6_METHOD_POST_PATH__v1_auth_change_password_PAYLOAD='{"token":"replace-with-test-token","newPassword":"test-password"}'
K6_METHOD_GET_PATH__v1_auth_csrf_PAYLOAD=''
K6_METHOD_GET_PATH__v1_auth_verify_email_PAYLOAD=''
K6_METHOD_GET_PATH__v1_auth_oidc_google_PAYLOAD=''
K6_METHOD_GET_PATH__v1_auth_oidc_google_callback_PAYLOAD=''
K6_METHOD_GET_PATH__v1_profile_me_PAYLOAD=''
K6_METHOD_PATCH_PATH__v1_profile_me_PAYLOAD='{"firstName":"Load Test"}'
# Replace the UUID in both this key and K6_PATH with the test profile's ID.
K6_METHOD_GET_PATH__v1_profile_00000000_0000_4000_8000_000000000000_PAYLOAD=''
K6_METHOD_GET_PATH__startup_PAYLOAD=''
K6_METHOD_GET_PATH__live_PAYLOAD=''
K6_METHOD_GET_PATH__ready_PAYLOAD=''
K6_METHOD_GET_PATH__metrics_PAYLOAD=''
