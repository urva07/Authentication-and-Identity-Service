ENVIRONMENT=development
SERVICE_NAME=mail-service
PORT=3002
HEALTH_APP_PORT=3003

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_TIMEOUT_MS=5000

BULLMQ_REDIS_HOST=redis_bullMQ
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_USERNAME=
BULLMQ_REDIS_PASSWORD=
BULLMQ_REDIS_DB=0
BULLMQ_REDIS_TLS=false

MAIL_QUEUE_NAME=mail
MAIL_JOB_ATTEMPTS=3
MAIL_JOB_BACKOFF_TYPE=exponential
MAIL_JOB_BACKOFF_DELAY_MS=1000
MAIL_REMOVE_ON_COMPLETE=100
MAIL_REMOVE_ON_FAIL=1000

MAIL_WORKER_CONCURRENCY=5
MAIL_WORKER_MAX_STALLED_COUNT=1
MAIL_WORKER_STALLED_INTERVAL_MS=30000
MAIL_WORKER_LOCK_DURATION_MS=30000

FORCE_CLOSE_TIMEOUT_MS=20000
