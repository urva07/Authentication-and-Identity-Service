# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
HEALTH_APP_PORT=3001
# Optional frontend origin for credentialed cross-origin cookie requests.
CORS_ORIGIN=
# Timeout for cancellable external HTTP/service calls, in milliseconds.
EXTERNAL_API_TIMEOUT_MS=10000

# MongoDB
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=
MONGO_AUTH_SOURCE=admin

# MySQL
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional Redis ACL credentials.
REDIS_USERNAME=
REDIS_PASSWORD=

# Authentication
# Generate a secret with: openssl rand -base64 32
JWT_SECRET=
# Used to encrypt sign-in verification tokens; generate a separate secret with:
# openssl rand -base64 32
SIGNIN_TOKEN_SECRET=

# SMTP email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
