# Application
NODE_ENV=development
DOMAIN='localhost'
PORT=3000
HEALTH_APP_PORT=3001
# Externally reachable API origin, used for email verification links.
API_BASE_URL='http://localhost:3000'
# Optional frontend origin for credentialed cross-origin cookie requests.
CORS_ORIGIN=
# Timeout for cancellable external HTTP/service calls, in milliseconds.
EXTERNAL_API_TIMEOUT_MS=10000
TOTAL_REQ_RES_CYCLE_TIMEOUT_MS=15000
CONNECTION_INACTIVITY_TIMEOUT_MS=10000
REQ_HEADERS_TIMEOUT_MS=5000
REQ_TIMEOUT_MS=20000
MAX_CONNECTIONS=1000
CONNECTION_KEEP_ALIVE_TIMEOUT_MS=20000
BODY_SIZE_LIMIT='100kb'


# services
FRONTEND_BASE_URL='http://localhost:3000'


# Database

    # MongoDB
    DATABASE_URL=
    MONGO_USERNAME=
    MONGO_PASSWORD=
    MONGO_HOST='localhost'
    MONGO_PORT=27017
    MONGO_DB_NAME=
    MONGO_AUTH_SOURCE='admin'

    # MySQL
    MYSQL_URL=
    MYSQL_HOST='localhost'
    MYSQL_PORT=3306
    MYSQL_USER=
    MYSQL_PASSWORD=
    MYSQL_DATABASE=

    # Redis
    REDIS_URL=
    REDIS_HOST='localhost'
    REDIS_PORT=6379
    # Optional Redis ACL credentials (docker compose defaults the username to "app").
    REDIS_USERNAME=
    REDIS_PASSWORD=

        #session redis
        SESSION_REDIS_HOST='redis_session'
        SESSION_REDIS_PORT=6379
        SESSION_REDIS_USERNAME='app'
        SESSION_REDIS_PASSWORD=
        SESSION_REDIS_DATABASE=0
        # Percentage applied once to a new session lifetime; 0 disables jitter.
        SESSION_REDIS_TTL_JITTER=10

        #cache redis
        USER_CACHE_REDIS_HOST='redis_user_cache'
        USER_CACHE_REDIS_PORT=6379
        USER_CACHE_REDIS_USERNAME='app'
        USER_CACHE_REDIS_PASSWORD=
        USER_CACHE_REDIS_DATABASE=1
        USER_CACHE_REDIS_TTL_JITTER=10

        #rate limiter redis
        RATE_LIMITER_REDIS_HOST='redis_rate_limiter'
        RATE_LIMITER_REDIS_PORT=6379
        RATE_LIMITER_REDIS_USERNAME='app'
        RATE_LIMITER_REDIS_PASSWORD=
        RATE_LIMITER_REDIS_DATABASE=0


# Mail
EMAIL_DELIVERY_MODE='sync'
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

BULLMQ_REDIS_HOST='redis_bullMQ'
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_USERNAME='app'
BULLMQ_REDIS_PASSWORD=
BULLMQ_REDIS_DB=0
BULLMQ_REDIS_TLS=false

MAIL_QUEUE_NAME='mail'
MAIL_JOB_ATTEMPTS=3
MAIL_JOB_BACKOFF_TYPE='exponential'
MAIL_JOB_BACKOFF_DELAY_MS=1000
MAIL_REMOVE_ON_COMPLETE=100
MAIL_REMOVE_ON_FAIL=1000


# OIDC
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_SCOPE='openid email profile'
OIDC_GOOGLE_CALLBACK_URL='http://localhost:3000/v1/auth/oidc/google/callback'


# SESSION

    # JWT BASED CLIENT SIDE SESSION
    JWT_ALGORITHM='HS256'
    # Generate each secret with: openssl rand -base64 32 (use a different one per secret)
    JWT_SECRET=

        # PASSWORD RESET TOKEN
        JWT_PASSWORD_RESET_TOKEN_SECRET=
        # Optional password reset link lifetime in seconds (default 900).
        JWT_PASSWORD_RESET_TOKEN_TTL_SECONDS=900

        # ACCESS TOKEN
        JWT_ACCESS_TOKEN_SECRET=
        JWT_ACCESS_TOKEN_EXPIRATION='24h'
        JWT_ACCESS_TOKEN_COOKIE_EXPIRATION_MILI='86400000'
        JWT_ACCESS_TOKEN_COOKIE_OPTIONS='{"httpOnly":true,"maxAge":86400000,"path":"/","sameSite":"lax","secure":true}'

        # REFRESH TOKEN
        JWT_REFRESH_TOKEN_SECRET=
        JWT_REFRESH_TOKEN_EXPIRATION='7d'
        JWT_REFRESH_TOKEN_COOKIE_EXPIRATION_MILI='604800000'
        JWT_REFRESH_TOKEN_COOKIE_OPTIONS='{"httpOnly":true,"maxAge":604800000,"path":"/","sameSite":"lax","secure":true}'

    # SERVER_SIDE_SESSION
    SESSION_SECRET=
    SESSION_RESAVE=true
    SESSION_SAVE_UNINITIALIZED=false
    SESSION_ROLLING=false
    SESSION_REDIS_TTL=86400

        # server-side Session cookie configuration
        SESSION_COOKIE_OPTIONS='{"httpOnly":true,"maxAge":86400000,"path":"/","sameSite":"lax","secure":false}'
        SESSION_COOKIE_DOMAIN='localhost'
        SESSION_COOKIE_HTTP_ONLY=true
        SESSION_COOKIE_MAX_AGE=86400000
        SESSION_COOKIE_PATH='/'
        SESSION_COOKIE_SAME_SITE='lax'
        SESSION_COOKIE_SECURE=false
        SESSION_COOKIE_PRIORITY='medium'
        SESSION_COOKIE_PARTITIONED=false


# Authentication

    # Ingress-to-service secret for x-user-id on /v1/profile routes.
    # Generate a distinct secret with: openssl rand -base64 32
    INGRESS_SHARED_SECRET=

    # Basic
    BASIC_HASH_SALT_ROUNDS=12
    # Encrypts sign-in verification tokens (AES-256-GCM); generate with: openssl rand -base64 32
    BASIC_SIGNIN_AES_256_GCM_TOKEN_SECRET=
    BASIC_SIGNIN_AES_256_GCM_TOKEN_TTL_SECONDS=1800
