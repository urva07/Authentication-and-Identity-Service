<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Verify email address</title>
    </head>
    <body style="margin: 0; padding: 24px; font-family: Arial, sans-serif; color: #222;">
        <main style="max-width: 560px; margin: 0 auto;">
            <h1 style="font-size: 24px;">Verify your email address</h1>
            <p>Hello <%= name %>,</p>
            <p>
                Use the URL below to verify your email address:
            </p>
            <p style="padding: 16px; background: #f3f4f6; font-size: 20px; font-weight: bold; letter-spacing: 2px; text-align: center;">
                <%= verificationUrl %>
            </p>
            <p>
                This link will expire in <%= tokenExpiry %>.
            </p>
            <p>
                If you did not request an email verification, you can ignore this email.
            </p>
        </main>
    </body>
</html>
