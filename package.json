{
  "name": "Authentication_Service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "docker:install": "docker compose exec app npm install",
    "docker:install:dev": "docker compose exec app npm install --save-dev",
    "start": "node src/server.js",
    "startwithdb": "/opt/homebrew/bin/brew services start mongodb-community && brew services start mysql && brew services start redis && npm start",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migration:create": "sequelize-cli migration:generate --name",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "compose": "docker compose up",
    "compose:d": "docker compose up -d",
    "compose:build": "docker compose up --build",
    "compose:build:d": "docker compose up -d --build",
    "compose:stop": "docker compose stop",
    "compose:restart": "docker compose restart",
    "compose:down": "docker compose down",
    "compose:down:v": "docker compose down -v",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*",
    "#middlewares/*": "./src/middlewares/*",
    "#config/*": "./src/config/*",
    "#services/*": "./src/services/*",
    "#repositories/*": "./src/repositories/*",
    "#monitoring/*": "./src/monitoring/*",
    "#utils/*": "./src/utils/*",
    "#errors/*": "./src/errors/*",
    "#routes/*": "./src/routes/*",
    "#controllers/*": "./src/controllers/*",
    "#validators/*": "./src/validators/*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "fast-json-stable-stringify": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.1.1",
    "passport": "^0.7.0",
    "passport-google-oidc": "^0.1.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}